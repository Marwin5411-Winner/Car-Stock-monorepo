<!-- หนังสือขอบคุณ (Thank You Letter) -->
<style>
  /* preferCSSPageSize: true with no @page used Letter (shorter than A4) and
     clipped ฝ่ายตรวจสอบ / the signature. Keep @page margin 0 — .page already
     pads 10mm; stacking both shrinks the box (same lesson as sales-summary). */
  @page {
    size: A4;
    margin: 0;
  }
  .page.ty-letter {
    page-break-after: auto;
  }
  @media print {
    .page.ty-letter {
      page-break-after: auto;
    }
  }
  .ty-letter .date-display {
    margin-top: 12px;
    text-align: right;
  }
  .ty-letter .date-display span {
    font-size: 16px;
  }
  .ty-title {
    text-align: left;
    margin-top: 8px;
  }
  .ty-title h1,
  .ty-title h2 {
    font-size: 16px;
    font-weight: bold;
  }
  .ty-title h2 {
    margin-top: 4px;
  }
  .ty-intro {
    margin-top: 10px;
    line-height: 1.45;
  }
  .ty-table {
    width: 90%;
    margin: 8px auto;
    font-size: 11px;
  }
  .ty-table th,
  .ty-table td {
    padding: 3px 8px;
  }
  .ty-gifts {
    vertical-align: top;
    font-size: 10px;
    line-height: 1.25;
  }
  .ty-closing {
    margin-top: 12px;
    line-height: 1.45;
  }
  .ty-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 16px;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .ty-footer .signature-box {
    width: auto;
  }
  .ty-footer .signature-line {
    width: 200px;
    margin-top: 28px;
  }
</style>

<div class="page ty-letter">
  {{> header}}

  <div class="date-display">
    <span>วันที่ {{thaiDate}}</span>
  </div>

  <div class="ty-title">
    <h1>เรื่อง ขอขอบคุณท่านผู้มีอุปการะคุณ</h1>
    <h2>เรียน {{customerName}}</h2>
  </div>

  <div class="content ty-intro">
    <p class="indent">
      ตามที่ท่านไว้วางใจให้กับ {{header.companyName}} และท่านได้ซื้อรถยนต์ไฟฟ้า 
      ยี่ห้อ <strong>{{carBrand}}</strong> ทะเบียนรถใหม่ป้ายแดง กับ {{header.companyName}} 
      ขอขอบพระคุณท่านผู้มีอุปการะคุณมา ทางบริษัท จึงได้จัดทำแบบสอบถามรายละเอียดต่าง ๆ 
      เพื่อเป็นข้อมูลในการบริการ หลังการขายและยืนยันส่วนลด ต่าง ๆ ที่ท่านได้รับถูกต้องตามนี้หรือไม่
    </p>
  </div>

  <table class="ty-table">
    <thead>
      <tr>
        <th style="width: 36%;">รายละเอียด</th>
        <th style="width: 24%;">จำนวนเงิน</th>
        <th style="width: 40%;">รายการของแถม</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>ราคาขาย</td>
        <td class="text-right">{{formatCurrency detailsTable.sellingPrice false}}</td>
        <td class="ty-gifts" rowspan="14">
          {{#each detailsTable.gifts}}
          • {{this.name}}<br>
          {{/each}}
        </td>
      </tr>
      <tr>
        <td>ส่วนลด (รถยนต์)</td>
        <td class="text-right">{{formatCurrency detailsTable.discount false}}</td>
      </tr>
      <tr>
        <td>คงเหลือ</td>
        <td class="text-right">{{formatCurrency detailsTable.remaining false}}</td>
      </tr>
      <tr>
        <td>เงินจอง</td>
        <td class="text-right">{{formatCurrency detailsTable.bookingDeposit false}}</td>
      </tr>
      <tr>
        <td>เงินดาวน์</td>
        <td class="text-right">{{formatCurrency detailsTable.downPayment false}}</td>
      </tr>
      <tr>
        <td>ส่วนลด (เงินดาวน์)</td>
        <td class="text-right">{{formatCurrency detailsTable.downPaymentDiscount false}}</td>
      </tr>
      <tr>
        <td>ค่าประกันภัยชั้น 1</td>
        <td class="text-right">{{formatCurrency detailsTable.insurance false}}</td>
      </tr>
      <tr>
        <td>ค่าพรบ.</td>
        <td class="text-right">{{formatCurrency detailsTable.actInsurance false}}</td>
      </tr>
      <tr>
        <td>ค่าจดทะเบียน</td>
        <td class="text-right">{{formatCurrency detailsTable.registrationFee false}}</td>
      </tr>
      <tr>
        <td>รวมเงินออกรถ</td>
        <td class="text-right"><strong>{{formatCurrency detailsTable.totalDelivery false}}</strong></td>
      </tr>
      <tr>
        <td>ยอดจัดไฟแนนซ์</td>
        <td class="text-right">{{formatCurrency detailsTable.financeAmount false}}</td>
      </tr>
      <tr>
        <td>อัตราดอกเบี้ยต่อปี</td>
        <td class="text-right">{{formatPercentage detailsTable.interestRate}}</td>
      </tr>
      <tr>
        <td>ผ่อนทั้งหมด : เดือน</td>
        <td class="text-right">{{detailsTable.installmentMonths}} เดือน</td>
      </tr>
      <tr>
        <td>งวดละ</td>
        <td class="text-right">{{formatCurrency detailsTable.monthlyPayment false}}</td>
      </tr>
    </tbody>
  </table>

  <div class="text-right ty-closing">
    <p>หากจำนวนเงินไม่ถูกต้องตรงตามรายการนี้</p>
    <p>กรุณาติดต่อกับเจ้าหน้าที่ด้านล่าง เพื่อประโยชน์ของตัวท่านเอง</p>
    <p>บริษัท ฯ ใคร่ขอขอบพระคุณที่ท่านให้ความร่วมมือมา ณ โอกาสนี้</p>
  </div>

  <div class="ty-footer">
    <div class="contact-box">
      <strong>ฝ่ายตรวจสอบ</strong><br>
      {{contactPerson.name}}<br>
      {{contactPerson.phone}}
    </div>

    <div class="signature-box">
      <p>ขอแสดงความนับถือ</p>
      <div class="signature-line"></div>
      <p>( {{header.companyName}} )</p>
    </div>
  </div>
</div>
